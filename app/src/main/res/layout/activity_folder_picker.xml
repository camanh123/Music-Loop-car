<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:gravity="center_vertical"
        android:minHeight="@dimen/header_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/folder_picker_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/header_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCancel"
            style="@style/Widget.MusicLoopCar.TransportButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_weight="0"
            android:minWidth="140dp"
            android:text="@string/folder_picker_cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/pathValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:ellipsize="start"
        android:padding="@dimen/panel_padding"
        android:singleLine="true"
        android:textColor="@color/accent"
        android:textSize="@dimen/status_text" />

    <ListView
        android:id="@+id/folderList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <Button
            android:id="@+id/buttonUp"
            style="@style/Widget.MusicLoopCar.TransportButton"
            android:layout_weight="1"
            android:text="@string/folder_picker_up" />

        <Button
            android:id="@+id/buttonSelect"
            style="@style/Widget.MusicLoopCar.TransportButton"
            android:layout_weight="1.4"
            android:text="@string/folder_picker_select" />
    </LinearLayout>

    <TextView
        android:id="@+id/buttonSafFallback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="@string/folder_picker_saf_fallback"
        android:textColor="@color/text_muted"
        android:textSize="16sp" />
</LinearLayout>
