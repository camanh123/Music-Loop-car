<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    tools:layout_height="720px"
    tools:layout_width="1280px">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/header_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/header_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/usbLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usb_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/status_text" />

        <TextView
            android:id="@+id/usbStatusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/usb_status_waiting"
            android:textColor="@color/accent"
            android:textSize="@dimen/status_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/musicLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="@string/music_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/status_text" />

        <TextView
            android:id="@+id/musicCountValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/music_count_placeholder"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/status_text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/panel_gap"
            android:layout_weight="1.15"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/panel_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="@dimen/section_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/albumArtwork"
                android:layout_width="@dimen/artwork_size"
                android:layout_height="@dimen/artwork_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_artwork"
                android:contentDescription="@string/artwork_description"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/songTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/now_playing_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/song_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/songArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/now_playing_empty_artist"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/song_meta" />

            <TextView
                android:id="@+id/songAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/now_playing_empty_album"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/song_meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/positionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_position_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_duration_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonPrevious"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1"
                    android:text="@string/action_previous" />

                <Button
                    android:id="@+id/buttonPlayPause"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1.2"
                    android:text="@string/action_play_pause" />

                <Button
                    android:id="@+id/buttonNext"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1"
                    android:text="@string/action_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonShuffle"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1"
                    android:text="@string/action_shuffle" />

                <Button
                    android:id="@+id/buttonRepeat"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1"
                    android:text="@string/action_repeat" />

                <Button
                    android:id="@+id/buttonFavorite"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_weight="1"
                    android:text="@string/action_favorite" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="@dimen/panel_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="@dimen/section_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabSongs"
                    style="@style/Widget.MusicLoopCar.LibraryTab"
                    android:layout_weight="1"
                    android:text="@string/library_songs" />

                <Button
                    android:id="@+id/tabArtists"
                    style="@style/Widget.MusicLoopCar.LibraryTab"
                    android:layout_weight="1"
                    android:text="@string/library_artists" />

                <Button
                    android:id="@+id/tabAlbums"
                    style="@style/Widget.MusicLoopCar.LibraryTab"
                    android:layout_weight="1"
                    android:text="@string/library_albums" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabFolders"
                    style="@style/Widget.MusicLoopCar.LibraryTab"
                    android:layout_weight="1"
                    android:text="@string/library_folders" />

                <Button
                    android:id="@+id/tabFavorites"
                    style="@style/Widget.MusicLoopCar.LibraryTab"
                    android:layout_weight="1"
                    android:text="@string/library_favorites" />
            </LinearLayout>

            <TextView
                android:id="@+id/libraryPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/library_empty"
                android:textColor="@color/text_muted"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
