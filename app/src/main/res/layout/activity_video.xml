<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <View
        android:id="@+id/clickCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonClose"
                style="@style/Widget.MusicLoopCar.TransportButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/player_button_height"
                android:layout_marginStart="12dp"
                android:minWidth="96dp"
                android:text="@string/close" />
        </LinearLayout>

        <View
            android:id="@+id/overlayScrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_overlay"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:textColor="@color/status_offline"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonRewind"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/video_transport_height"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/rewind" />

                <Button
                    android:id="@+id/buttonPrevious"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/video_transport_height"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/previous" />

                <Button
                    android:id="@+id/buttonPlayPause"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/video_transport_height"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.2"
                    android:text="@string/play" />

                <Button
                    android:id="@+id/buttonNext"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/video_transport_height"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/next" />

                <Button
                    android:id="@+id/buttonForward"
                    style="@style/Widget.MusicLoopCar.TransportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/video_transport_height"
                    android:layout_weight="1"
                    android:text="@string/forward" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/positionText"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:minHeight="32dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/durationText"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/clock_zero"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonFullscreen"
                style="@style/Widget.MusicLoopCar.TransportButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/player_button_height"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:minWidth="120dp"
                android:text="@string/fullscreen" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
